# Nome comercial (configurável)
NEXT_PUBLIC_APP_NAME=VELVET

# Supabase (público: URL e anon key; seguro apenas com RLS ativa)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor. NUNCA prefixar com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Provedores (MVP: modo demo explícito)
PAYMENT_PROVIDER=demo            # demo | (provedor validado para conteúdo adulto)
AGE_VERIFICATION_PROVIDER=declaration   # declaration | (provedor futuro)

# E-mail transacional (verificação, recuperação de senha)
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
